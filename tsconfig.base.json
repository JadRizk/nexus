{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@nexus-cyberdeck/tokens": ["./packages/tokens/src/index.ts"],
      "@nexus-cyberdeck/tokens/*": ["./packages/tokens/src/*"],
      "@nexus-cyberdeck/react": ["./packages/react/src/index.ts"],
      "@nexus-cyberdeck/react/*": ["./packages/react/src/*"],
      "@nexus-cyberdeck/graph": ["./packages/graph/src/index.ts"]
    }
  }
}
