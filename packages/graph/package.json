{
  "name": "@nexus-cyberdeck/graph",
  "version": "1.1.0",
  "license": "MIT",
  "description": "Force-directed WebGL graph canvas for React, built on Three.js, with SDF glyph nodes, curved links, and an optional CRT post-process. Companion to the Nexus Cyberdeck design system.",
  "keywords": [
    "react",
    "graph",
    "force-directed",
    "webgl",
    "three",
    "threejs",
    "visualization",
    "network-graph",
    "shaders",
    "nexus-cyberdeck"
  ],
  "homepage": "https://github.com/JadRizk/nexus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JadRizk/nexus.git",
    "directory": "packages/graph"
  },
  "bugs": {
    "url": "https://github.com/JadRizk/nexus/issues"
  },
  "author": "Jad Rizk",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "three": ">=0.170.0 <1.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^3.2.7"
  }
}
