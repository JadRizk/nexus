{
  "name": "@nexus-cyberdeck/react",
  "version": "3.0.0",
  "license": "MIT",
  "description": "React components for the Nexus Cyberdeck HUD design system: 19 accessible, token-driven primitives and overlays (panels, command palette, drawer, tabs, sliders, glyphs) with a WCAG AA theme.",
  "keywords": [
    "react",
    "components",
    "design-system",
    "ui",
    "accessible",
    "wcag",
    "a11y",
    "dark-theme",
    "hud",
    "cyberpunk",
    "command-palette",
    "nexus-cyberdeck"
  ],
  "homepage": "https://github.com/JadRizk/nexus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JadRizk/nexus.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/JadRizk/nexus/issues"
  },
  "author": "Jad Rizk",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build:styles": "node build-styles.mjs",
    "build": "npm run build:styles && tsup && cp src/styles.css dist/",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@nexus-cyberdeck/tokens": "3.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^3.2.7"
  }
}
