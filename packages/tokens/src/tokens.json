{
  "$schema": "https://raw.githubusercontent.com/amzn/style-dictionary/main/schema.json",
  "primitive": {
    "colour": {
      "void": "#08090A",
      "panel": "#0A0C0B",
      "raised": "#11150F",
      "acid": { "value": "#C6F135", "contrastOnSurface": 14.98 },
      "data": { "value": "#17E2E5", "contrastOnSurface": 12.19 },
      "lime": { "value": "#7CFF4F", "contrastOnSurface": 15.2 },
      "sodium": { "value": "#FF8A1E", "contrastOnSurface": 8.32 },
      "violet": { "value": "#9D7BFF", "contrastOnSurface": 6.27 },
      "phosphor": { "value": "#DFF5C7", "contrastOnSurface": 16.84 },
      "alarm": {
        "value": "#FF2E63",
        "contrastOnSurface": 5.44,
        "note": "Restricted. Reachable only through semantic.colour.fg.critical."
      }
    },
    "greyRamp": {
      "hud-aa": {
        "grey-100": "#2F382B", "grey-200": "#53624B", "grey-300": "#6B7F61",
        "grey-400": "#788E6D", "grey-500": "#8DA084", "grey-600": "#B0BDA9"
      },
      "hud": {
        "grey-100": "#1B2318", "grey-200": "#2C3729", "grey-300": "#3D4C39",
        "grey-400": "#4A5C46", "grey-500": "#5E7359", "grey-600": "#6E8768"
      }
    },
    "space": { "0": "0", "1": "2px", "2": "4px", "3": "6px", "4": "8px", "5": "12px", "6": "16px", "7": "24px", "8": "32px" },
    "motion": { "durMicro": "100ms", "durFade": "180ms", "durPanel": "220ms", "ease": "cubic-bezier(0.2, 0.9, 0.3, 1)", "blink": "1.06s" },
    "shape": { "hairline": "1px", "radius": "0", "tick": "9px" }
  },
  "semantic": {
    "bg": { "canvas": "primitive.colour.void", "surface": "primitive.colour.panel", "raised": "primitive.colour.raised" },
    "fg": {
      "default": "primitive.colour.phosphor",
      "accent": "primitive.colour.acid",
      "info": "primitive.colour.data",
      "warning": "primitive.colour.sodium",
      "critical": "primitive.colour.alarm"
    },
    "border": { "default": "greyRamp.grey-100", "strong": "greyRamp.grey-200", "accent": "fg.accent" }
  },
  "theme": {
    "hud-aa": { "fontScale": 1.15, "default": true },
    "hud": { "fontScale": 1 }
  }
}
