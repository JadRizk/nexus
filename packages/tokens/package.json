{
  "name": "@nexus/tokens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./crt.css": "./src/crt.css",
    "./tokens.json": "./src/tokens.json"
  },
  "scripts": {
    "build": "tsup && cp src/tokens.css src/crt.css src/tokens.json dist/",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  }
}
