{
  "name": "@nexus-cyberdeck/tokens",
  "version": "3.0.0",
  "license": "MIT",
  "description": "Design tokens for the Nexus Cyberdeck HUD design system: CSS custom properties for two themes (WCAG AA and the original HUD), typed accessors, and build-time contrast checks. W3C DTCG source.",
  "keywords": [
    "design-tokens",
    "design-system",
    "css-custom-properties",
    "dtcg",
    "wcag",
    "accessibility",
    "dark-theme",
    "hud",
    "cyberpunk",
    "nexus-cyberdeck"
  ],
  "homepage": "https://github.com/JadRizk/nexus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JadRizk/nexus.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/JadRizk/nexus/issues"
  },
  "author": "Jad Rizk",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens.css": "./dist/tokens.css",
    "./crt.css": "./dist/crt.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build:tokens": "node build-tokens.mjs",
    "build": "npm run build:tokens && tsup && cp src/tokens.css src/crt.css src/tokens.json dist/",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^3.2.7"
  }
}
